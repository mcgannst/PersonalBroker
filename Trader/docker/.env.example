# Trader environment variables (SPEC §13): the NAMES only, never values. Copy to .env.dev (or .env.prod),
# which are git-ignored, and fill in the values there. A blank value (KEY=) means "unset".
# deploy.sh reads the file named by TRADER_ENV_FILE; compose passes it to the container as `env_file`.

# --- required -------------------------------------------------------------------------------------------------
# App role (non-owner) connection URL: postgresql+psycopg://<role>:<password>@<host>:5432/<db>
DATABASE_URL=
# Owner role URL, used only by `alembic upgrade` in the entrypoint (unset before the processes start)
MIGRATION_DATABASE_URL=
# Fernet key for the stored Questrade tokens and TOTP secrets
APP_ENCRYPTION_KEY=
# Cookie and Telegram callback signing secret
SESSION_SECRET=

# --- integrations (optional: each feature is off without its key) ---------------------------------------------
# Claude: catalyst classification and the weekly commentary
ANTHROPIC_API_KEY=
# Telegram bot and the one authorized chat (both, or neither)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Read only by `trader questrade-seed` to start the token chain (never used after seeding)
QUESTRADE_REFRESH_TOKEN=

# --- web ------------------------------------------------------------------------------------------------------
# Base URL used in Telegram links, e.g. https://trader-dev.sunspinner.ca
PUBLIC_BASE_URL=
# First-run web user (only used while no user exists; `trader create-admin` runs at every start)
ADMIN_USERNAME=
ADMIN_PASSWORD_INITIAL=
# Private IPs or CIDR networks whose X-Forwarded-For uvicorn trusts (default: 172.19.0.0/16, the Docker
# `proxy` network of Nginx Proxy Manager); check it with `docker network inspect proxy` when deploying
TRADER_FORWARDED_ALLOW_IPS=

# --- optional -------------------------------------------------------------------------------------------------
# Display time zone of the web app and messages (default America/Edmonton)
TZ_DISPLAY=
# dev | prod (the compose files set it)
APP_ENV=
# The image's version label (deploy.sh sets it)
APP_VERSION=
# The built web app directory (default: the image's web/dist)
WEB_DIST_DIR=
# The FinViz cache directory (default: ~/.cache/trader/finviz)
TRADER_FINVIZ_CACHE_DIR=
# Seconds run-worker.sh waits before restarting a worker that exited 2 or 3 (default 30)
WORKER_RESTART_DELAY=
